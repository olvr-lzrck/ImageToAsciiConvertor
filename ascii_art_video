    <script>
        (function() {
            'use strict';

            // ─── DOM refs ──────────────────────────────────────────────
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const videoPlayer = document.getElementById('videoPlayer');
            const videoContainer = document.getElementById('videoContainer');
            const playPauseBtn = document.getElementById('playPauseBtn');
            const seekSlider = document.getElementById('seekSlider');
            const timeDisplay = document.getElementById('timeDisplay');
            const captureBtn = document.getElementById('captureBtn');

            const widthSlider = document.getElementById('widthSlider');
            const widthNumber = document.getElementById('widthNumber');
            const charSetSelect = document.getElementById('charSet');
            const fontSelector = document.getElementById('fontSelector');
            const invertCheck = document.getElementById('invertCheck');
            const scaleFactor = document.getElementById('scaleFactor');
            const contrastCheck = document.getElementById('contrastCheck');
            const sharpenCheck = document.getElementById('sharpenCheck');
            const generateBtn = document.getElementById('generateBtn');
            const downloadPngBtn = document.getElementById('downloadPngBtn');
            const downloadSvgBtn = document.getElementById('downloadSvgBtn');
            const downloadTxtBtn = document.getElementById('downloadTxtBtn');
            const downloadVideoBtn = document.getElementById('downloadVideoBtn');
            const copyBtn = document.getElementById('copyBtn');
            const clearBtn = document.getElementById('clearBtn');
            const asciiOutput = document.getElementById('asciiOutput');
            const outputWrapper = document.getElementById('outputWrapper');
            const outputCard = document.getElementById('outputCard');
            const statusMsg = document.getElementById('statusMsg');
            const outputInfo = document.getElementById('outputInfo');
            const progressContainer = document.getElementById('progressContainer');
            const progressFill = document.getElementById('progressFill');
            const progressText = document.getElementById('progressText');
            const performanceNote = document.getElementById('performanceNote');

            // ─── state ──────────────────────────────────────────────────
            let currentVideoFile = null;
            let currentAsciiString = '';
            let animationId = null;
            let isPlaying = false;
            let isProcessing = false;
            let isExportingVideo = false;

            // ─── charsets ─────────────────────────────────────────────
            const CHARSETS = {
                vibe: [
                    '@', '$', '%', '&', '#', 'B', '8', 'W', 'M', '*',
                    'o', 'a', 'h', 'k', 'b', 'd', 'p', 'q', 'w', 'm',
                    'Z', 'O', '0', 'Q', 'L', 'C', 'J', 'U', 'Y', 'X',
                    'z', 'c', 'v', 'u', 'n', 'x', 'r', 'j', 'f', 't',
                    '/', '\\', '|', '(', ')', '1', '{', '}', '[', ']',
                    '?', '-', '_', '+', '~', '<', '>', 'i', '!', 'l',
                    'I', ';', ':', '"', '^', '`', '\'', '.', ' '
                ],
                standard: ['@', '#', 'S', '%', '?', '*', '+', ';', ':', ',', '.', ' '],
                blocks: ['█', '▓', '▒', '░', ' '],
                detailed: ['$', '@', 'B', '%', '8', '&', 'W', 'M', '#', '*', 'o', 'a', 'h', 'k', 'b', 'd', 'p', 'q', 'w',
                    'm', 'Z', 'O', '0', 'Q', 'L', 'C', 'J', 'U', 'Y', 'X', 'z', 'c', 'v', 'u', 'n', 'x', 'r', 'j', 'f',
                    't', '/', '\\', '|', '(', ')', '1', '{', '}', '[', ']', '?', '-', '_', '+', '~', '<', '>', 'i', '!',
                    'l', 'I', ';', ':', '"', '^', '`', '\'', '.', ' '
                ],
                simple: ['#', '=', '-', ':', '.', ' '],
                cyber: ['█', '▓', '▒', '♦', '♣', '♠', '♥', '○', '●', '◐', '◑', '◒', '◓', ' '],
                wave: ['~', '≈', '≥', '≤', '∞', '∝', '∫', '√', '∂', '∆', ' '],
                braille: ['⠿', '⠾', '⠽', '⠼', '⠻', '⠺', '⠹', '⠸', '⠷', '⠶', '⠵', '⠴', '⠳', '⠲', '⠱', '⠰', '⠯', '⠮', '⠭', '⠬',
                    '⠫', '⠪', '⠩', '⠨', '⠧', '⠦', '⠥', '⠤', '⠣', '⠢', '⠡', '⠠', '⠟', '⠞', '⠝', '⠜', '⠛', '⠚', '⠙', '⠘',
                    '⠗', '⠖', '⠕', '⠔', '⠓', '⠒', '⠑', '⠐', '⠏', '⠎', '⠍', '⠌', '⠋', '⠊', '⠉', '⠈', '⠇', '⠆', '⠅', '⠄',
                    '⠃', '⠂', '⠁', ' '
                ]
            };

            // ─── helpers ───────────────────────────────────────────────
            function setStatus(msg, type) {
                statusMsg.textContent = msg;
                statusMsg.className = 'status-msg' + (type ? ' ' + type : '');
            }

            function showError(msg) { setStatus('✖ ' + msg, 'error'); }
            function showSuccess(msg) { setStatus('✔ ' + msg, 'success'); }
            function showInfo(msg) { setStatus('⟡ ' + msg, 'info'); }
            function showWarning(msg) { setStatus('⚠ ' + msg, 'warning'); }

            // ─── sharpening filter ─────────────────────────────────────
            function applySharpen(imageData) {
                const data = imageData.data;
                const width = imageData.width;
                const height = imageData.height;
                const output = new Uint8ClampedArray(data);
                const kernel = [0, -1, 0, -1, 5, -1, 0, -1, 0];
                const size = 3;
                const half = Math.floor(size / 2);
                for (let y = half; y < height - half; y++) {
                    for (let x = half; x < width - half; x++) {
                        let r = 0,
                            g = 0,
                            b = 0;
                        for (let ky = 0; ky < size; ky++) {
                            for (let kx = 0; kx < size; kx++) {
                                const px = (y + ky - half) * width + (x + kx - half);
                                const idx = px * 4;
                                const weight = kernel[ky * size + kx];
                                r += data[idx] * weight;
                                g += data[idx + 1] * weight;
                                b += data[idx + 2] * weight;
                            }
                        }
                        const idx = (y * width + x) * 4;
                        output[idx] = Math.min(255, Math.max(0, r));
                        output[idx + 1] = Math.min(255, Math.max(0, g));
                        output[idx + 2] = Math.min(255, Math.max(0, b));
                        output[idx + 3] = data[idx + 3];
                    }
                }
                return output;
            }

            // ─── frame to ASCII ──────────────────────────────────────
            function frameToAscii(videoElement, targetWidth, charsetName, invert, scale, contrast, sharpen, rawLines) {
                const charset = CHARSETS[charsetName] || CHARSETS.standard;
                const aspect = videoElement.videoWidth / videoElement.videoHeight;
                const charAspect = 0.52;
                const finalWidth = Math.round(targetWidth * scale);
                const targetHeight = Math.max(1, Math.round(finalWidth / aspect * charAspect));

                const canvas = document.createElement('canvas');
                canvas.width = finalWidth;
                canvas.height = targetHeight;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(videoElement, 0, 0, finalWidth, targetHeight);

                const imageData = ctx.getImageData(0, 0, finalWidth, targetHeight);
                let data = imageData.data;

                if (sharpen) {
                    const sharpened = applySharpen(imageData);
                    data = sharpened;
                }

                const total = finalWidth * targetHeight;
                const gray = new Uint8Array(total);
                const contrastFactor = contrast ? 1.5 : 1.0;

                for (let i = 0; i < total; i++) {
                    const idx = i * 4;
                    let g = Math.round(0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2]);
                    if (contrast) {
                        g = (g - 128) * contrastFactor + 128;
                        g = Math.min(255, Math.max(0, g));
                    }
                    gray[i] = g;
                }

                const len = charset.length;
                const lines = [];
                for (let y = 0; y < targetHeight; y++) {
                    let line = '';
                    for (let x = 0; x < finalWidth; x++) {
                        const idx = y * finalWidth + x;
                        let val = gray[idx] / 255;
                        if (invert) val = 1 - val;
                        if (val < 0) val = 0;
                        if (val > 1) val = 1;
                        const charIdx = Math.round(val * (len - 1));
                        line += charset[Math.min(charIdx, len - 1)];
                    }
                    lines.push(line);
                }

                if (rawLines) return lines;
                return lines.join('\n');
            }

            // ─── get ASCII lines ─────────────────────────────────────
            function getAsciiLines(overrideWidth) {
                const width = overrideWidth || parseInt(widthNumber.value, 10) || 80;
                const charset = charSetSelect.value;
                const invert = invertCheck.checked;
                const scale = parseFloat(scaleFactor.value);
                const contrast = contrastCheck.checked;
                const sharpen = sharpenCheck.checked;

                return frameToAscii(videoPlayer, width, charset, invert, scale, contrast, sharpen, true);
            }

            // ─── update ASCII output ──────────────────────────────────
            function updateAscii() {
                if (!videoPlayer.videoWidth || !videoPlayer.videoHeight) {
                    return;
                }
                if (isProcessing) return;
                isProcessing = true;

                try {
                    const lines = getAsciiLines();
                    currentAsciiString = lines.join('\n');
                    asciiOutput.textContent = currentAsciiString;
                    asciiOutput.style.fontFamily = fontSelector.value;
                    outputCard.style.display = 'block';
                    downloadPngBtn.disabled = false;
                    downloadSvgBtn.disabled = false;
                    downloadTxtBtn.disabled = false;
                    downloadVideoBtn.disabled = false;

                    autoResizeOutput(lines);
                    const info = `· ${lines.length}×${lines[0]?.length || 0}`;
                    outputInfo.textContent = info;
                } catch (e) { /* silent */ }

                isProcessing = false;
            }

            // ─── auto-resize output ──────────────────────────────────
            function autoResizeOutput(lines) {
                if (!lines || lines.length === 0) return;
                const wrapper = outputWrapper;
                const maxHeight = window.innerHeight * 0.6;
                const maxWidth = wrapper.clientWidth - 32;
                let fontSize = 14;
                const minFont = 5;
                const maxFont = 30;
                const maxLineLen = Math.max(...lines.map(l => l.length));

                let low = minFont,
                    high = maxFont;
                let bestSize = fontSize;
                for (let iter = 0; iter < 20; iter++) {
                    const mid = (low + high) / 2;
                    const cw = mid * 0.6;
                    const lh = mid * 1.25;
                    const tw = maxLineLen * cw + 16;
                    const th = lines.length * lh + 16;
                    if (tw <= maxWidth && th <= maxHeight) {
                        bestSize = mid;
                        low = mid;
                    } else {
                        high = mid;
                    }
                }
                bestSize = Math.min(maxFont, Math.max(minFont, Math.round(bestSize * 10) / 10));
                asciiOutput.style.fontSize = bestSize + 'px';
                asciiOutput.style.lineHeight = (bestSize * 1.25 / bestSize) + '';
            }

            // ─── animation loop (live preview) ──────────────────────
            function frameLoop() {
                if (!videoPlayer.paused && videoPlayer.readyState >= 2) {
                    updateAscii();
                }
                if (isPlaying) {
                    animationId = requestAnimationFrame(frameLoop);
                }
            }

            // ─── video controls ──────────────────────────────────────
            function togglePlay() {
                if (videoPlayer.paused) {
                    videoPlayer.play().catch(e => showError('Playback error: ' + e.message));
                } else {
                    videoPlayer.pause();
                }
            }

            function updateTimeDisplay() {
                const duration = videoPlayer.duration || 0;
                const current = videoPlayer.currentTime || 0;
                const fmt = (t) => {
                    const m = Math.floor(t / 60);
                    const s = Math.floor(t % 60);
                    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
                };
                timeDisplay.textContent = fmt(current) + ' / ' + fmt(duration);
                if (duration) {
                    seekSlider.value = (current / duration) * 100;
                }
            }

            // ─── load video ──────────────────────────────────────────
            function loadVideoFile(file) {
                if (!file || !file.type.startsWith('video/')) {
                    showError('Please select a valid video file.');
                    return;
                }
                currentVideoFile = file;
                const url = URL.createObjectURL(file);
                videoPlayer.src = url;
                videoPlayer.load();
                videoPlayer.onloadedmetadata = function() {
                    videoContainer.style.display = 'block';
                    document.getElementById('controlsRow').style.display = 'flex';
                    generateBtn.disabled = false;
                    downloadVideoBtn.disabled = false;
                    videoPlayer.play().then(() => {
                        isPlaying = true;
                        playPauseBtn.textContent = '⏸ pause';
                        if (animationId) cancelAnimationFrame(animationId);
                        frameLoop();
                    }).catch(e => {
                        showInfo('Press play to start');
                        isPlaying = false;
                        playPauseBtn.textContent = '▶ play';
                    });
                    updateTimeDisplay();
                    showSuccess('Video loaded! Adjust settings and watch the ASCII art.');
                };
                videoPlayer.onplay = function() {
                    isPlaying = true;
                    playPauseBtn.textContent = '⏸ pause';
                    if (animationId) cancelAnimationFrame(animationId);
                    frameLoop();
                };
                videoPlayer.onpause = function() {
                    isPlaying = false;
                    playPauseBtn.textContent = '▶ play';
                    if (animationId) {
                        cancelAnimationFrame(animationId);
                        animationId = null;
                    }
                };
                videoPlayer.ontimeupdate = updateTimeDisplay;
                videoPlayer.onended = function() {
                    isPlaying = false;
                    playPauseBtn.textContent = '▶ play';
                    if (animationId) {
                        cancelAnimationFrame(animationId);
                        animationId = null;
                    }
                };
                videoPlayer.onerror = function() {
                    showError('Video error. Please try a different format.');
                };
                seekSlider.addEventListener('input', function() {
                    const duration = videoPlayer.duration;
                    if (duration) {
                        videoPlayer.currentTime = (this.value / 100) * duration;
                    }
                });
                videoPlayer.addEventListener('seeked', function() {
                    updateAscii();
                });
            }

            // ─── capture frame ──────────────────────────────────────
            function captureFrame() {
                if (!currentVideoFile || !videoPlayer.videoWidth) {
                    showError('No video loaded.');
                    return;
                }
                updateAscii();
                const lines = currentAsciiString.split('\n');
                const fontSize = 14;
                const charW = fontSize * 0.6;
                const lineH = fontSize * 1.25;
                const maxLen = Math.max(...lines.map(l => l.length));
                const pad = 32;
                const cw = maxLen * charW + pad * 2;
                const ch = lines.length * lineH + pad * 2;
                const canvas = document.createElement('canvas');
                canvas.width = Math.ceil(cw);
                canvas.height = Math.ceil(ch);
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#000000';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.font = `${fontSize}px ${fontSelector.value}`;
                ctx.textBaseline = 'top';
                ctx.fillStyle = '#cccccc';
                for (let i = 0; i < lines.length; i++) {
                    ctx.fillText(lines[i], pad, pad + i * lineH);
                }
                const link = document.createElement('a');
                link.download = 'ascii-frame.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
                showSuccess('PNG downloaded.');
            }

            // ─── fast video export using real‑time playback ─────────
            async function downloadFullVideo() {
                if (isExportingVideo) return;
                if (!videoPlayer.videoWidth || !videoPlayer.videoHeight) {
                    showError('No video loaded.');
                    return;
                }

                const duration = videoPlayer.duration;
                if (!duration || duration <= 0) {
                    showError('Invalid video duration.');
                    return;
                }

                // Save playback state
                const wasPlaying = !videoPlayer.paused;
                const currentTime = videoPlayer.currentTime;

                // Pause and seek to start
                videoPlayer.pause();
                videoPlayer.currentTime = 0;
                await new Promise(resolve => {
                    const handler = () => {
                        videoPlayer.removeEventListener('seeked', handler);
                        resolve();
                    };
                    videoPlayer.addEventListener('seeked', handler);
                    setTimeout(resolve, 1000);
                });

                isExportingVideo = true;
                downloadVideoBtn.disabled = true;
                progressContainer.classList.add('active');
                progressFill.style.width = '0%';
                progressText.textContent = 'Initializing...';
                performanceNote.classList.remove('active');

                try {
                    const width = parseInt(widthNumber.value, 10) || 80;
                    const scale = parseFloat(scaleFactor.value);
                    const charset = charSetSelect.value;
                    const invert = invertCheck.checked;
                    const contrast = contrastCheck.checked;
                    const sharpen = sharpenCheck.checked;

                    // Determine ASCII grid size from first frame
                    const firstLines = frameToAscii(videoPlayer, width, charset, invert, scale, contrast, sharpen, true);
                    const numLines = firstLines.length;
                    const maxLineLen = Math.max(...firstLines.map(l => l.length));

                    // Compute canvas size with base font
                    const baseFontSize = 16;
                    const pad = 32;
                    let natWidth = maxLineLen * baseFontSize * 0.6 + pad * 2;
                    let natHeight = numLines * baseFontSize * 1.25 + pad * 2;

                    // Adaptive scaling to stay within 4M pixels
                    const MAX_PIXELS = 4000000;
                    let finalFontSize = baseFontSize;
                    let recWidth = natWidth;
                    let recHeight = natHeight;
                    const pixelArea = natWidth * natHeight;

                    if (pixelArea > MAX_PIXELS) {
                        const scaleFactor = Math.sqrt(MAX_PIXELS / pixelArea);
                        finalFontSize = Math.max(4, Math.floor(baseFontSize * scaleFactor));
                        recWidth = Math.ceil(maxLineLen * finalFontSize * 0.6 + pad * 2);
                        recHeight = Math.ceil(numLines * finalFontSize * 1.25 + pad * 2);
                        performanceNote.classList.add('active');
                        performanceNote.textContent =
                            `⚡ Performance note: Large ASCII grid (${Math.round(pixelArea/1000000)}M pixels). Font scaled to ${finalFontSize}px (${Math.round(recWidth*recHeight/1000000)}M pixels).`;
                    } else {
                        performanceNote.classList.remove('active');
                    }

                    // Cap max dimension to avoid browser issues
                    const MAX_DIM = 4096;
                    if (recWidth > MAX_DIM || recHeight > MAX_DIM) {
                        const scaleDim = Math.min(MAX_DIM / recWidth, MAX_DIM / recHeight);
                        finalFontSize = Math.max(4, Math.floor(finalFontSize * scaleDim));
                        recWidth = Math.ceil(maxLineLen * finalFontSize * 0.6 + pad * 2);
                        recHeight = Math.ceil(numLines * finalFontSize * 1.25 + pad * 2);
                        performanceNote.classList.add('active');
                        performanceNote.textContent += ` Canvas capped at ${MAX_DIM}×${MAX_DIM}.`;
                    }

                    // Create canvas and stream
                    const canvas = document.createElement('canvas');
                    canvas.width = recWidth;
                    canvas.height = recHeight;
                    const ctx = canvas.getContext('2d');

                    // Determine recording FPS (match video or cap at 30)
                    const videoFps = 30; // assume 30 if can't get
                    const fps = Math.min(30, videoFps);

                    const stream = canvas.captureStream(fps);
                    const mimeTypes = [
                        'video/mp4;codecs=h264',
                        'video/mp4;codecs=avc1',
                        'video/webm;codecs=vp9',
                        'video/webm;codecs=vp8',
                        'video/webm',
                        'video/mp4'
                    ];
                    let selectedMime = mimeTypes.find(m => MediaRecorder.isTypeSupported(m));
                    if (!selectedMime) {
                        selectedMime = 'video/webm';
                    }

                    // Set bitrate to 5 Mbps for quality
                    const recorder = new MediaRecorder(stream, {
                        mimeType: selectedMime,
                        videoBitsPerSecond: 5000000
                    });
                    const chunks = [];

                    recorder.ondataavailable = function(e) {
                        if (e.data.size > 0) chunks.push(e.data);
                    };

                    // Start playing video from beginning
                    videoPlayer.currentTime = 0;
                    await videoPlayer.play();

                    let startTime = performance.now();
                    let lastProgress = 0;
                    let framesRecorded = 0;

                    recorder.start(1000);

                    // Capture loop using requestAnimationFrame
                    const captureLoop = () => {
                        if (videoPlayer.paused && !videoPlayer.ended) {
                            requestAnimationFrame(captureLoop);
                            return;
                        }

                        if (videoPlayer.ended) {
                            recorder.stop();
                            return;
                        }

                        // Draw current frame
                        try {
                            const lines = frameToAscii(videoPlayer, width, charset, invert, scale, contrast, sharpen, true);
                            ctx.fillStyle = '#000000';
                            ctx.fillRect(0, 0, recWidth, recHeight);
                            ctx.font = `${finalFontSize}px ${fontSelector.value}`;
                            ctx.textBaseline = 'top';
                            ctx.fillStyle = '#cccccc';
                            for (let j = 0; j < lines.length; j++) {
                                const line = lines[j].substring(0, Math.floor(recWidth / (finalFontSize * 0.6)));
                                ctx.fillText(line, pad, pad + j * finalFontSize * 1.25);
                            }
                            framesRecorded++;
                        } catch (e) {
                            // ignore
                        }

                        // Update progress based on video time
                        const progress = (videoPlayer.currentTime / duration) * 100;
                        if (progress - lastProgress >= 1) {
                            progressFill.style.width = Math.min(100, progress) + '%';
                            progressText.textContent =
                                `Recording ${Math.round(progress)}% · ${Math.round(videoPlayer.currentTime)}/${Math.round(duration)}s · ${framesRecorded} frames`;
                            lastProgress = progress;
                        }

                        requestAnimationFrame(captureLoop);
                    };

                    captureLoop();

                    // When recorder stops, download
                    recorder.onstop = function() {
                        const blob = new Blob(chunks, { type: selectedMime });
                        const url = URL.createObjectURL(blob);
                        const link = document.createElement('a');
                        let ext = 'webm';
                        if (selectedMime.includes('mp4') || selectedMime.includes('avc1')) ext = 'mp4';
                        link.download = `ascii_video.${ext}`;
                        link.href = url;
                        link.click();
                        URL.revokeObjectURL(url);
                        showSuccess(`✅ Video exported (${ext.toUpperCase()}) — ${framesRecorded} frames.`);
                        progressFill.style.width = '100%';
                        progressText.textContent = `✅ Done! ${framesRecorded} frames, ${duration.toFixed(1)}s.`;

                        // Restore playback state
                        videoPlayer.pause();
                        videoPlayer.currentTime = currentTime;
                        if (wasPlaying) {
                            videoPlayer.play().catch(() => {});
                        }
                        isExportingVideo = false;
                        downloadVideoBtn.disabled = false;
                        setTimeout(() => {
                            progressContainer.classList.remove('active');
                            performanceNote.classList.remove('active');
                        }, 3000);
                    };

                } catch (err) {
                    showError('Video export failed: ' + err.message);
                    isExportingVideo = false;
                    downloadVideoBtn.disabled = false;
                    progressContainer.classList.remove('active');
                    performanceNote.classList.remove('active');
                    videoPlayer.pause();
                    videoPlayer.currentTime = currentTime;
                    if (wasPlaying) {
                        videoPlayer.play().catch(() => {});
                    }
                }
            }

            // ─── downloads ─────────────────────────────────────────────
            function downloadPng() {
                if (!currentAsciiString) { showError('No art to download.'); return; }
                try {
                    const lines = currentAsciiString.split('\n');
                    const fontSize = 14;
                    const charW = fontSize * 0.6;
                    const lineH = fontSize * 1.25;
                    const maxLen = Math.max(...lines.map(l => l.length));
                    const pad = 32;
                    const cw = maxLen * charW + pad * 2;
                    const ch = lines.length * lineH + pad * 2;
                    const canvas = document.createElement('canvas');
                    canvas.width = Math.ceil(cw);
                    canvas.height = Math.ceil(ch);
                    const ctx = canvas.getContext('2d');
                    ctx.fillStyle = '#000000';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.font = `${fontSize}px ${fontSelector.value}`;
                    ctx.textBaseline = 'top';
                    ctx.fillStyle = '#cccccc';
                    for (let i = 0; i < lines.length; i++) {
                        ctx.fillText(lines[i], pad, pad + i * lineH);
                    }
                    const link = document.createElement('a');
                    link.download = 'ascii-frame.png';
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                    showSuccess('PNG downloaded.');
                } catch (e) { showError('PNG error: ' + e.message); }
            }

            function downloadSvg() {
                if (!currentAsciiString) { showError('No art to download.'); return; }
                try {
                    const lines = currentAsciiString.split('\n');
                    const fontSize = 14;
                    const charW = fontSize * 0.6;
                    const lineH = fontSize * 1.25;
                    const maxLen = Math.max(...lines.map(l => l.length));
                    const pad = 32;
                    const sw = maxLen * charW + pad * 2;
                    const sh = lines.length * lineH + pad * 2;
                    let svg =
                        `<svg xmlns="http://www.w3.org/2000/svg" width="${sw}" height="${sh}" viewBox="0 0 ${sw} ${sh}">
              <rect width="100%" height="100%" fill="#000000"/>
              <g font-family="${fontSelector.value}" font-size="${fontSize}" fill="#cccccc" dominant-baseline="hanging">`;
                    for (let i = 0; i < lines.length; i++) {
                        const escaped = lines[i].replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                        svg += `<text x="${pad}" y="${pad + i * lineH}">${escaped}</text>`;
                    }
                    svg += `</g></svg>`;
                    const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.download = 'ascii-frame.svg';
                    link.href = url;
                    link.click();
                    URL.revokeObjectURL(url);
                    showSuccess('SVG downloaded.');
                } catch (e) { showError('SVG error: ' + e.message); }
            }

            function downloadTxt() {
                if (!currentAsciiString) { showError('No art to download.'); return; }
                try {
                    const blob = new Blob([currentAsciiString], { type: 'text/plain;charset=utf-8' });
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.download = 'ascii-frame.txt';
                    link.href = url;
                    link.click();
                    URL.revokeObjectURL(url);
                    showSuccess('TXT downloaded.');
                } catch (e) { showError('TXT error: ' + e.message); }
            }

            function copyAscii() {
                if (!currentAsciiString) { showError('No art to copy.'); return; }
                navigator.clipboard.writeText(currentAsciiString).then(() => {
                    showSuccess('Copied to clipboard!');
                }).catch(() => {
                    const ta = document.createElement('textarea');
                    ta.value = currentAsciiString;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    showSuccess('Copied!');
                });
            }

            function clearAll() {
                currentVideoFile = null;
                currentAsciiString = '';
                videoPlayer.pause();
                videoPlayer.src = '';
                videoContainer.style.display = 'none';
                document.getElementById('controlsRow').style.display = 'none';
                outputCard.style.display = 'none';
                asciiOutput.innerHTML = '<span class="placeholder">⟡ video will appear here as ASCII</span>';
                downloadPngBtn.disabled = true;
                downloadSvgBtn.disabled = true;
                downloadTxtBtn.disabled = true;
                downloadVideoBtn.disabled = true;
                generateBtn.disabled = true;
                fileInput.value = '';
                if (animationId) {
                    cancelAnimationFrame(animationId);
                    animationId = null;
                }
                isPlaying = false;
                playPauseBtn.textContent = '▶ play';
                setStatus('⟡ upload a video to begin', '');
                if (videoPlayer.src) URL.revokeObjectURL(videoPlayer.src);
                progressContainer.classList.remove('active');
                isExportingVideo = false;
                outputInfo.textContent = '';
                performanceNote.classList.remove('active');
            }

            // ─── sync slider + number ─────────────────────────────────
            widthSlider.addEventListener('input', function() {
                widthNumber.value = this.value;
                if (videoPlayer.videoWidth) updateAscii();
            });
            widthNumber.addEventListener('input', function() {
                let v = parseInt(this.value, 10);
                if (isNaN(v)) return;
                if (v < 4) v = 4;
                if (v > 500) v = 500;
                widthSlider.value = v;
                if (videoPlayer.videoWidth) updateAscii();
            });

            // ─── other controls cause live update ──────────────────
            ['charSet', 'fontSelector', 'scaleFactor'].forEach(id => {
                document.getElementById(id).addEventListener('change', function() {
                    if (videoPlayer.videoWidth) updateAscii();
                });
            });
            ['invertCheck', 'contrastCheck', 'sharpenCheck'].forEach(id => {
                document.getElementById(id).addEventListener('change', function() {
                    if (videoPlayer.videoWidth) updateAscii();
                });
            });

            // ─── resize ──────────────────────────────────────────────
            window.addEventListener('resize', function() {
                if (videoPlayer.videoWidth && currentAsciiString) {
                    const lines = currentAsciiString.split('\n');
                    if (lines.length > 1) {
                        autoResizeOutput(lines);
                    }
                }
            });

            // ─── events ────────────────────────────────────────────────
            dropZone.addEventListener('click', function(e) {
                if (e.target.tagName !== 'INPUT') fileInput.click();
            });
            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
            dropZone.addEventListener('dragleave', function(e) {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            });
            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                if (e.dataTransfer.files.length) loadVideoFile(e.dataTransfer.files[0]);
            });
            fileInput.addEventListener('change', function() {
                if (this.files && this.files.length) loadVideoFile(this.files[0]);
            });

            playPauseBtn.addEventListener('click', togglePlay);
            captureBtn.addEventListener('click', captureFrame);
            generateBtn.addEventListener('click', function() {
                if (videoPlayer.videoWidth) updateAscii();
            });
            downloadPngBtn.addEventListener('click', downloadPng);
            downloadSvgBtn.addEventListener('click', downloadSvg);
            downloadTxtBtn.addEventListener('click', downloadTxt);
            downloadVideoBtn.addEventListener('click', downloadFullVideo);
            copyBtn.addEventListener('click', copyAscii);
            clearBtn.addEventListener('click', clearAll);

            // ─── init ──────────────────────────────────────────────────
            clearAll();

            window.__videoAscii = {
                updateAscii,
                captureFrame,
                clearAll,
                downloadFullVideo
            };

        })();
    </script>

